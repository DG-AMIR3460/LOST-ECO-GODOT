; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lost Eco"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://autoloads/GameManager.gd"
QuestManager="*res://autoloads/QuestManager.gd"
DialogueManager="*res://autoloads/DialogueManager.gd"
AudioManager="*res://autoloads/AudioManager.gd"
SettingsManager="*res://autoloads/SettingsManager.gd"
SceneTransition="*res://autoloads/SceneTransition.gd"
UISounds="*res://autoloads/UISounds.gd"
MenuStateMachine="*res://autoloads/MenuStateMachine.gd"
StoryReflections="*res://autoloads/StoryReflections.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

